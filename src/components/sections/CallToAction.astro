---
import Button from '../elements/Button.astro';

interface Props { heading: string; text: string; label: string; url: string }
const { heading, text, label, url } = Astro.props;
---
<section class="container call-to-action" aria-labelledby="cta-heading">
  <div><h2 id="cta-heading">{heading}</h2><p>{text}</p></div>
  <Button href={url} variant="secondary">{label}</Button>
</section>
<style>
  .call-to-action { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-block: var(--space-xl); padding: clamp(1.5rem, 4vw, 3rem); background: var(--color-primary); color: white; border-radius: var(--radius-lg); }
  h2 { font-size: clamp(1.65rem, 3vw, 2.25rem); }
  p { margin-top: .75rem; color: #bfd2d0; }
  .call-to-action :global(.button) { flex-shrink: 0; background: #74d3c5; border-color: #74d3c5; }
  .call-to-action :global(.button:hover) { background: #8ee3d6; }
  @media (max-width: 52rem) { .call-to-action { flex-direction: column; align-items: flex-start; } }
</style>

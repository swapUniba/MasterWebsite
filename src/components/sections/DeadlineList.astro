---
import type { CollectionEntry } from 'astro:content';
import { formatItalianDate } from '../../utils/dates';
import { withBase } from '../../utils/url';

interface Props { items: CollectionEntry<'deadlines'>['data']['items'] }
const { items } = Astro.props;
---
<ol class="deadline-list">
  {items.map((item) => (
    <li>
      <p class="deadline-list__date"><time datetime={item.date}>{formatItalianDate(item.date)}</time>{item.time && <span> · ore {item.time}</span>}</p>
      <h3>{item.url ? <a href={withBase(item.url)}>{item.title}</a> : item.title}</h3>
      {item.description && <p class="deadline-list__description">{item.description}</p>}
    </li>
  ))}
</ol>
<style>
  .deadline-list { padding: clamp(1.5rem, 4vw, 2.5rem); list-style: none; background: var(--color-primary); color: white; border-radius: var(--radius-lg); }
  li + li { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .2); }
  .deadline-list__date { color: #8cd7cd; font-size: .9rem; font-weight: 700; }
  h3 { margin-block: .5rem; font-size: 1.15rem; }
  a { color: inherit; }
  .deadline-list__description { color: #bfd2d0; font-size: .9rem; }
</style>

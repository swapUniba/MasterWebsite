---
import { withBase } from '../../utils/url';

interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumb container" aria-label="Percorso di navigazione"><ol>{items.map((item, index) => <li>{item.href && index < items.length - 1 ? <a href={withBase(item.href)}>{item.label}</a> : <span aria-current={index === items.length - 1 ? 'page' : undefined}>{item.label}</span>}</li>)}</ol></nav>

---
import type { CollectionEntry } from 'astro:content';
import { formatItalianDate } from '../../utils/dates';

interface Props { entry: CollectionEntry<'news'> }
const { entry } = Astro.props;
const news = entry.data;
---
<article class="news-card">
  {news.image && <img src={news.image} alt={news.image_alt} width="640" height="360" loading="lazy" />}
  <p class="eyebrow"><time datetime={news.date.toISOString().slice(0, 10)}>{formatItalianDate(news.date)}</time></p>
  <h3><a href={`/news/${entry.id}/`}>{news.title}</a></h3>
  <p class="news-card__summary">{news.summary}</p>
</article>
<style>
  .news-card { padding: 1.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); overflow-wrap: anywhere; }
  img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-sm); margin-bottom: 1.25rem; }
  h3 { margin-block: .75rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .news-card__summary { color: var(--color-text-muted); font-size: .95rem; }
</style>

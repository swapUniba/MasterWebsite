---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import Notice from '../components/elements/Notice.astro';
import Section from '../components/layout/Section.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import PageHeader from '../components/layout/PageHeader.astro';

const [masterEntry, contactsEntry, faqEntry] = await Promise.all([
  getEntry('master', 'master'),
  getEntry('contacts', 'contacts'),
  getEntry('faq', 'faq'),
]);
if (!masterEntry) throw new Error('Contenuto obbligatorio mancante: master/master (src/data/master.yml).');
if (!contactsEntry) throw new Error('Contenuto obbligatorio mancante: contacts/contacts (src/data/contacts.yml).');
if (!faqEntry) throw new Error('Contenuto obbligatorio mancante: faq/faq (src/data/faq.yml).');
const master = masterEntry.data;
const contacts = contactsEntry.data;

const DEFAULT_CATEGORY = 'Altro';
const items = [...faqEntry.data.items].sort((a, b) => a.order - b.order);
const categories: string[] = [];
for (const item of items) {
  const category = item.category ?? DEFAULT_CATEGORY;
  if (!categories.includes(category)) categories.push(category);
}
const groups = categories.map((category) => ({
  category,
  items: items.filter((item) => (item.category ?? DEFAULT_CATEGORY) === category),
}));
---
<BaseLayout title="Domande frequenti" description="Risposte alle domande più comuni su ammissione, didattica e costi del Master.">
  <Notice message={master.demo_notice} />
  <Header master={master} currentPath={Astro.url.pathname} />
  <main id="main-content" tabindex="-1">
    <PageHeader title="Domande frequenti" eyebrow="FAQ" description="Le risposte rapide alle domande più frequenti su ammissione, didattica e costi." />
    {groups.map((group, index) => (
      <Section labelledBy={`faq-${index}-heading`} tinted={index % 2 === 1}>
        <SectionHeading id={`faq-${index}-heading`} title={group.category} />
        <div class="faq-list">
          {group.items.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </Section>
    ))}
  </main>
  <Footer master={master} contacts={contacts} />
</BaseLayout>
<style>
  .faq-list { display: grid; gap: 1rem; }
  .faq-item { padding: 1.25rem clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .faq-item summary { cursor: pointer; font-weight: 650; }
  .faq-item p { margin-top: .75rem; color: var(--color-text-muted); }
</style>
